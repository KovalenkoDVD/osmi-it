# --- Telegram -----------------------------------------------------------------
# Token from @BotFather
BOT_TOKEN=
# Telegram user ids allowed to run /reindex, comma separated (your id: @userinfobot)
ADMIN_IDS=

# --- LLM ----------------------------------------------------------------------
# anthropic (Claude, default) | openai (any OpenAI-compatible API) | none (quotes only, no LLM)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5
# Claude effort: low | medium | high. "low" = fastest replies, enough for FAQ-style RAG.
LLM_EFFORT=low
ANTHROPIC_API_KEY=

# Google Gemini (free key: https://aistudio.google.com/api-keys):
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-2.5-flash
# GEMINI_API_KEY=

# Fully local LLM in a container (Ollama, no API keys, CPU is enough):
#   docker compose --profile local-llm up -d
# LLM_PROVIDER=openai
# LLM_MODEL=qwen2.5:3b
# OPENAI_BASE_URL=http://ollama:11434/v1
# OLLAMA_MODEL=qwen2.5:3b
# On CPU keep the prompt short: 4 chunks instead of 8 (2-30 s per answer instead of ~1 min)
# TOP_K=4

# OpenAI-compatible alternative (OpenAI, OpenRouter, DeepSeek, Ollama, vLLM...):
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# --- Embeddings -----------------------------------------------------------------
# Local CPU model: no API key, the knowledge base never leaves the server.
# Changing the model wipes the vectors automatically; run ingest afterwards.
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=384

# --- Knowledge base -----------------------------------------------------------
START_URLS=https://osmi-it.ru/,https://osmi-ai.ru/,https://docs.osmi-ai.ru/
ALLOWED_HOSTS=osmi-it.ru,osmi-ai.ru,docs.osmi-ai.ru
CRAWL_MAX_PAGES=600
# Build the knowledge base automatically on the first start
AUTO_INGEST=true

# --- Postgres (docker-compose) --------------------------------------------------
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag
# Only used when running the Python code on the host instead of in Docker:
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag

# --- Langfuse tracing (optional) ------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
